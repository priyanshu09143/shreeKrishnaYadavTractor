<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="main-content">
  <section class="page-banner">
    <div class="page">
      <p class="section-eyebrow" style="color:var(--amber-light)"><%= t('about_eyebrow') %></p>
      <h1 class="section-title" style="color:#fff;font-size:2.2rem"><%= t('about_title') %></h1>
    </div>
  </section>

  <div class="page">
    <div class="about-prose">
      <p><%= t('about_p1') %></p>
      <p><%= t('about_p2') %></p>
      <p><%= t('about_p3') %></p>
    </div>

    <div class="benefit-grid benefit-grid-2">
      <div class="benefit-card dark">
        <div class="benefit-icon"><%- icons.shieldCheck %></div>
        <h3><%= t('about_mission_title') %></h3>
        <p><%= t('about_mission_desc') %></p>
      </div>
      <div class="benefit-card">
        <div class="benefit-icon"><%- icons.badgeCheck %></div>
        <h3><%= t('about_vision_title') %></h3>
        <p><%= t('about_vision_desc') %></p>
      </div>
    </div>
  </div>
</main>
<%- include('partials/footer') %>
