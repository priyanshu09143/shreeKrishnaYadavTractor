<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="main-content">
  <section class="page-banner">
    <div class="page">
      <p class="section-eyebrow" style="color:var(--amber-light)"><%= t('contact_eyebrow') %></p>
      <h1 class="section-title" style="color:#fff;font-size:2.2rem"><%= t('contact_title') %></h1>
      <p class="section-desc" style="color:#d3e1d5"><%= t('contact_desc') %></p>
    </div>
  </section>

  <div class="page">
    <div class="contact-layout">
      <div class="contact-info-card">
        <h3 class="section-title" style="font-size:1.3rem"><%= t('contact_info_title') %></h3>
        <div class="contact-info-row">
          <span class="brand-mark" style="background:var(--green-tint-2);color:var(--green-600)"><%- icons.phone %></span>
          <div>
            <p class="price-label"><%= t('contact_info_phone') %></p>
            <a href="tel:<%= CONTACT.phoneTel %>" style="font-weight:700;color:var(--heading-dark)"><%= CONTACT.phoneDisplay %></a>
          </div>
        </div>
        <div class="contact-info-row">
          <span class="brand-mark" style="background:var(--green-tint-2);color:var(--green-600)"><%- icons.mapPin %></span>
          <div>
            <p class="price-label"><%= t('contact_info_email') %></p>
            <a href="mailto:<%= CONTACT.email %>" style="font-weight:700;color:var(--heading-dark)"><%= CONTACT.email %></a>
          </div>
        </div>
        <div class="contact-info-row">
          <span class="brand-mark" style="background:var(--green-tint-2);color:var(--green-600)"><%- icons.mapPin %></span>
          <div>
            <p class="price-label"><%= t('contact_info_address') %></p>
            <p style="font-weight:700;color:var(--heading-dark);margin:0"><%= CONTACT.address %></p>
            <a href="<%= CONTACT.mapsUrl %>" target="_blank" rel="noreferrer" style="font-size:0.85rem"><%= t('footer_get_directions') %></a>
          </div>
        </div>
        <a href="https://wa.me/<%= CONTACT.whatsapp %>?text=<%= encodeURIComponent(lang === 'en' ? 'Hello, I have a question.' : 'नमस्ते, मुझे एक सवाल पूछना है।') %>" target="_blank" rel="noreferrer" class="btn btn-whatsapp" style="width:100%;justify-content:center;margin-top:0.5rem"><%- icons.whatsapp %> <%= t('contact_whatsapp_btn') %></a>
      </div>

      <% if (submitted) { %>
        <div class="form" style="align-items:flex-start">
          <span class="brand-mark" style="background:var(--green-tint-2);color:var(--green-600)"><%- icons.badgeCheck %></span>
          <h3 class="section-title" style="font-size:1.4rem;margin-top:1rem"><%= t('contact_success_title') %></h3>
          <p class="muted" style="margin-top:0.5rem"><%= t('contact_success_desc') %></p>
        </div>
      <% } else { %>
      <form class="form" method="POST" action="/contact">
        <h3 class="section-title" style="font-size:1.3rem"><%= t('contact_form_title') %></h3>

        <label><%= t('contact_label_name') %></label>
        <input required name="name" placeholder="<%= t('placeholder_name') %>" value="<%= form.name || '' %>" />

        <label><%= t('contact_label_phone') %></label>
        <input required type="tel" name="phone" placeholder="<%= t('placeholder_phone') %>" value="<%= form.phone || '' %>" />

        <label><%= t('contact_label_email') %></label>
        <input type="email" name="email" value="<%= form.email || '' %>" />

        <label><%= t('contact_label_message') %></label>
        <textarea rows="4" name="message" placeholder="<%= t('contact_placeholder_message') %>"><%= form.message || '' %></textarea>

        <% if (error) { %><p class="error"><%= error %></p><% } %>
        <button class="btn btn-primary" type="submit"><%= t('contact_submit') %> <%- icons.arrowUpRight %></button>
      </form>
      <% } %>
    </div>
  </div>
</main>
<%- include('partials/footer') %>
