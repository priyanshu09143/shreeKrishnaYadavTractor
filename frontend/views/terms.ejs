    </section>
    <section class="terms-section">
      <h2><%= t('terms_s3_title') %></h2>
      <p><%= t('terms_s3_body') %></p>
    </section>
    <section class="terms-section">
      <h2><%= t('terms_s4_title') %></h2>
      <p><%= t('terms_s4_body') %></p>
    </section>
    <section class="terms-section">
      <h2><%= t('terms_s5_title') %></h2>
      <p><%= t('terms_s5_body') %></p>
    </section>
  </div>
</main>
<%- include('partials/footer') %>
